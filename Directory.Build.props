<Project>
  <PropertyGroup>
    <!-- B44.Common consumes the opt-in agent-guidance synchronization shipped
         by B44.Standards. The anchor remains repository-relative. -->
    <B44AgentSyncEnabled>true</B44AgentSyncEnabled>
    <B44AgentGuidanceProfile>Organization</B44AgentGuidanceProfile>
    <B44AgentRepositoryRoot>$(MSBuildThisFileDirectory)</B44AgentRepositoryRoot>
    <B44AgentSyncProject>$(MSBuildThisFileDirectory)B44.Common\B44.Common.csproj</B44AgentSyncProject>

    <!-- Run the source-size ratchet once from the same anchor project. -->
    <B44RatchetEnabled>true</B44RatchetEnabled>
    <B44RatchetProject>$(MSBuildThisFileDirectory)B44.Common\B44.Common.csproj</B44RatchetProject>
    <B44RatchetRepositoryRoot>$(MSBuildThisFileDirectory)</B44RatchetRepositoryRoot>
    <B44RatchetBaseline>$(MSBuildThisFileDirectory)ratchet-baseline.txt</B44RatchetBaseline>

    <!-- Repository hygiene and the analyzer-suppression ratchet, both anchored
         to the same project as the checks above. The budget records what the
         repository has today; raising it is a deliberate one-line edit in this
         reviewed file. -->
    <B44HygieneEnabled>true</B44HygieneEnabled>
    <!-- Two, both justified at the site they sit on: the IsExternalInit
         polyfill must live in a compiler-dictated namespace (IDE0130), and
         SystemRandomSource is the sanctioned wrapper the RS0030 ban points
         callers to. -->
    <B44SuppressionBudget>2</B44SuppressionBudget>
    <B44WarningPolicy>true</B44WarningPolicy>

  </PropertyGroup>

  <!-- B44.Common multi-targets, and both anchored targets above run once per
       inner build. Pinning them to a single target framework keeps the two
       repository-wide scans from running twice over the same generated files
       concurrently. net8.0 is the pinned one because it is the target every
       current consumer binds to, and because the other one is provisional. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net8.0'">
    <B44AgentSyncEnabled>false</B44AgentSyncEnabled>
    <B44RatchetEnabled>false</B44RatchetEnabled>
    <B44HygieneEnabled>false</B44HygieneEnabled>
    <B44SuppressionBudget></B44SuppressionBudget>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test projects exceed the ratchet by doctrine. -->
    <B44RatchetExclude Include="B44.Common.Tests" />
    <B44RatchetExclude Include="artifacts" />
  </ItemGroup>

  <ItemGroup>
    <!-- Consume the independently versioned policy package exactly as every
         other B44 repository does. -->
    <PackageReference Include="B44.Standards" Version="0.12.*" PrivateAssets="all" />
  </ItemGroup>
</Project>
