<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Required on .NET 10 SDK: without this, `dotnet test` restores and
         exits without running any xunit.v3 tests. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- The repository root, so the target-framework invariants can be asserted
         against the source they are invariants of. Passed through MSBuild rather
         than walked at run time, because the test binary's distance from the
         repository root is a build-layout detail. -->
    <B44RepositoryRoot>$(MSBuildThisFileDirectory)..\</B44RepositoryRoot>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>B44RepositoryRoot</_Parameter1>
      <_Parameter2>$(B44RepositoryRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\B44.Common\B44.Common.csproj" />
  </ItemGroup>

  <Target Name="PreventGodotDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="'@(PackageReference->WithMetadataValue('Identity','Godot.NET.Sdk'))' != ''"
           Text="B44.Common must stay engine-free. Do not reference Godot packages." />
    <Error Condition="'@(PackageReference->WithMetadataValue('Identity','GodotSharp'))' != ''"
           Text="B44.Common must stay engine-free. Do not reference Godot packages." />
    <Error Condition="'@(Reference->WithMetadataValue('Identity','GodotSharp'))' != ''"
           Text="B44.Common must stay engine-free. Do not reference Godot assemblies." />
  </Target>
</Project>
