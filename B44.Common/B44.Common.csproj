<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0 is what this package is: ordinary modern portable .NET.
         netstandard2.1 is PROVISIONAL and has a sunset condition — see the
         Target Frameworks decision record in CLAUDE.md before relying on it or
         extending the pattern. It is here because a host still on that profile
         cannot load a net8.0 assembly at all, and because this source already
         compiled to it unchanged: no API differs by target framework and no
         type is conditioned on one. If that ever stops being true, the answer
         is to drop the target rather than work around it. -->
    <TargetFrameworks>netstandard2.1;net8.0</TargetFrameworks>
    <PackageId>B44.Common</PackageId>
    <Version>0.11.3</Version>
    <Authors>DA-Sandman-Jr</Authors>
    <Company>B44 Labs</Company>
    <Description>Engine-free shared primitives for B44 games: structured logging, injected randomness, durable atomic JSON persistence, and repository abstractions.</Description>
    <RepositoryUrl>https://github.com/DA-Sandman-Jr/B44.Common</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- All rights reserved is not an SPDX identifier, so the licence
         travels as a bundled file rather than an expression. Also stops
         nuget.org warning "License missing" on every publish. -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Copyright>Copyright (c) 2026 David Sanders (B44 Labs). All rights reserved.</Copyright>
    <RootNamespace>B44.Common</RootNamespace>
    <!-- Explicit because the netstandard2.1 target would otherwise default to
         C# 8, and record structs (LogCategory, StructuredLogEvent) need 10. -->
    <LangVersion>latest</LangVersion>
    <!-- Embed sources and the PDB in the assembly so consuming repos (and the
         agents working in them) can read and step into package code from the
         primary package without coordinating a separate symbols artifact. -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <!-- Engine-free invariant, enforced by B44.Standards (banned symbols +
         resolved-reference guard). -->
    <B44EngineFreeCore>true</B44EngineFreeCore>

    <!-- Released-compatibility validation, stock .NET Package Validation. It
         runs inside `dotnet pack` and diffs this package against the one named
         below, which is downloaded during restore — so the release workflow's
         no-build pack keeps working unchanged.

         A test suite protects the API surface it exercises: delete a member a
         test calls, or change its signature, and the test stops compiling. It
         says nothing about the rest — nothing here calls a member purely to
         prove it still exists, so public API no test happens to touch can be
         removed or narrowed with the suite still green. Package Validation
         compares the whole published surface rather than the exercised slice.
         Consumers would otherwise find out when they float onto the new
         version and fail to compile. This moves that to pack time.

         The baseline should represent the latest published compatibility
         surface while the next release is being developed, and must be advanced
         after each successful publish, alongside the <Version> hint above.

         A stale baseline is not merely stricter. API introduced after it and
         removed again never appears in the comparison at all, so the removal
         escapes: add a public Foo() in 0.11.4, delete it in 0.11.5, and a
         baseline still pinned at 0.11.3 never contained Foo() and reports
         nothing.

         Breaks are expected at a 0.x minor and are not forbidden here; they
         become explicit. Record a deliberate one in CompatibilitySuppressions.xml
         via `dotnet pack -p:GenerateCompatibilitySuppressionFile=true`, so the
         file is the reviewable list of what was broken on purpose. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.11.3</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <!-- In-box from net8.0 onwards, a package only on the older profile.
         The 10.x line is deliberate: its netstandard2.1 assets leave
         System.Memory, System.Buffers and System.Threading.Tasks.Extensions
         to the platform, where the 8.x line drags netstandard2.0 copies of
         all three alongside and duplicates types the host already has. -->
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
