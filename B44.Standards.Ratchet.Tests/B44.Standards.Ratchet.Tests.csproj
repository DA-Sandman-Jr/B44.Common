<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- Build-only integration fixture for the source-size ratchet, mirroring
         B44.Standards.AgentGuidance.Tests. It exercises the exact source target
         packed by B44.Standards against synthetic repositories under obj/.

         The repository-wide ratchet that B44.Common runs on itself must not
         also run here: this project is not the anchor, so B44VerifyRatchet
         skips it and the fixture drives the task directly. -->
    <_FixtureRoot>$(MSBuildProjectDirectory)\obj\RatchetFixture\</_FixtureRoot>

    <!-- Assertion 6 deliberately feeds the task a malformed baseline and
         downgrades the resulting B44R001 error to a warning so the fixture can
         inspect the outcome. Demote it further to a message: a green build must
         not carry a warning that is actually a passing negative test. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);B44R001</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <Target Name="PrepareRatchetFixture" BeforeTargets="Build">
    <MakeDir Directories="$(_FixtureRoot);$(_FixtureRoot)Core;$(_FixtureRoot)Fixture.Tests;$(_FixtureRoot)Core\obj;$(_FixtureRoot).godot" />
    <!-- Delete the specific artifacts each run depends on being absent or
         regenerated, rather than the whole tree: a RemoveDir here fails
         whenever anything holds a handle on the fixture directory. -->
    <Delete Files="$(_FixtureRoot)missing-baseline.txt;$(_FixtureRoot)ratchet-baseline.txt;$(_FixtureRoot)broken-baseline.txt" />

    <!-- Small.cs: 3 lines, under every threshold. -->
    <WriteLinesToFile File="$(_FixtureRoot)Core\Small.cs" Lines="// a;// b;// c" Overwrite="true" />

    <!-- MSBuild has no loop and cannot call Enumerable.Range, so N lines is a
         padded string with each pad character rewritten into "line;". The
         trailing separator yields an empty item, which MSBuild drops, so the
         count is exact. -->
    <PropertyGroup>
      <_Lines400>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.String]::Copy('').PadRight(400, 'x')), 'x', '// line;'))))</_Lines400>
      <_Lines600>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.String]::Copy('').PadRight(600, 'x')), 'x', '// line;'))))</_Lines600>
    </PropertyGroup>

    <!-- Tracked.cs: 400 lines. Over the 350 tracking threshold, so a generated
         baseline records it; under the 500 new-file limit. -->
    <WriteLinesToFile File="$(_FixtureRoot)Core\Tracked.cs" Lines="$(_Lines400)" Overwrite="true" />

    <!-- Oversized.cs: 600 lines with no baseline entry — the new-file violation. -->
    <WriteLinesToFile File="$(_FixtureRoot)Core\Oversized.cs" Lines="$(_Lines600)" Overwrite="true" />

    <!-- Files the scan must never see: excluded top-level dirs, and bin/obj at
         any depth. Each is oversized, so a scan that reaches one is a failure
         that shows up as a violation count rather than a silent pass. -->
    <WriteLinesToFile File="$(_FixtureRoot)Fixture.Tests\HugeTest.cs" Lines="$(_Lines600)" Overwrite="true" />
    <WriteLinesToFile File="$(_FixtureRoot).godot\Generated.cs" Lines="$(_Lines600)" Overwrite="true" />
    <WriteLinesToFile File="$(_FixtureRoot)Core\obj\Generated.cs" Lines="$(_Lines600)" Overwrite="true" />
  </Target>

  <ItemGroup>
    <_FixtureExclude Include="Fixture.Tests" />
    <_FixtureExclude Include=".godot" />
  </ItemGroup>

  <Target Name="VerifyRatchetFixture" AfterTargets="PrepareRatchetFixture">
    <!-- 1. No baseline file at all means an empty baseline: only the file over
            the new-file limit violates. Proves exclusions and bin/obj skipping
            hold, since four oversized files exist but three are out of scope. -->
    <B44SourceSizeRatchetTask
      RepositoryRoot="$(_FixtureRoot)"
      BaselinePath="$(_FixtureRoot)missing-baseline.txt"
      ExcludedDirectories="@(_FixtureExclude)"
      NewFileMaxLines="500"
      TrackThresholdLines="350"
      WriteBaseline="false"
      FailOnViolation="false">
      <Output TaskParameter="ViolationCount" PropertyName="_NoBaselineViolations" />
    </B44SourceSizeRatchetTask>
    <Error Condition="'$(_NoBaselineViolations)' != '1'"
           Text="Expected exactly one violation (Core/Oversized.cs) with no baseline; got '$(_NoBaselineViolations)'. An excluded directory or a bin/obj subtree was scanned." />

    <!-- 2. Writing a baseline records only files over the tracking threshold. -->
    <B44SourceSizeRatchetTask
      RepositoryRoot="$(_FixtureRoot)"
      BaselinePath="$(_FixtureRoot)ratchet-baseline.txt"
      ExcludedDirectories="@(_FixtureExclude)"
      NewFileMaxLines="500"
      TrackThresholdLines="350"
      WriteBaseline="true"
      FailOnViolation="true" />
    <Error Condition="!Exists('$(_FixtureRoot)ratchet-baseline.txt')"
           Text="B44WriteRatchetBaseline did not produce a baseline file." />
    <ReadLinesFromFile File="$(_FixtureRoot)ratchet-baseline.txt">
      <Output TaskParameter="Lines" ItemName="_BaselineLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_BaselineText>@(_BaselineLines, '|')</_BaselineText>
    </PropertyGroup>
    <Error Condition="$([System.String]::Copy('$(_BaselineText)').Contains('Core/Tracked.cs = 400')) != 'True'"
           Text="The generated baseline did not record Core/Tracked.cs at 400 lines. Got: $(_BaselineText)" />
    <Error Condition="$([System.String]::Copy('$(_BaselineText)').Contains('Core/Oversized.cs = 600')) != 'True'"
           Text="The generated baseline did not record Core/Oversized.cs at 600 lines." />
    <Error Condition="$([System.String]::Copy('$(_BaselineText)').Contains('Small.cs')) == 'True'"
           Text="The generated baseline recorded a file under the tracking threshold." />
    <Error Condition="$([System.String]::Copy('$(_BaselineText)').Contains('HugeTest.cs')) == 'True'"
           Text="The generated baseline recorded a file inside an excluded directory." />
    <Error Condition="$([System.String]::Copy('$(_BaselineText)').Contains('B44WriteRatchetBaseline')) != 'True'"
           Text="The baseline header does not name the command that regenerates it." />

    <!-- 3. Verifying immediately after writing must be clean: a freshly written
            baseline that its own gate rejects is the drift this entry exists to
            prevent. Same exclude list feeds both, which is the point. -->
    <B44SourceSizeRatchetTask
      RepositoryRoot="$(_FixtureRoot)"
      BaselinePath="$(_FixtureRoot)ratchet-baseline.txt"
      ExcludedDirectories="@(_FixtureExclude)"
      NewFileMaxLines="500"
      TrackThresholdLines="350"
      WriteBaseline="false"
      FailOnViolation="false">
      <Output TaskParameter="ViolationCount" PropertyName="_RoundTripViolations" />
    </B44SourceSizeRatchetTask>
    <Error Condition="'$(_RoundTripViolations)' != '0'"
           Text="A freshly generated baseline did not satisfy its own gate; got $(_RoundTripViolations) violation(s)." />

    <!-- 4. Growth past a recorded baseline is a violation, even well under the
            new-file limit — the no-growth rule is the actual policy. -->
    <PropertyGroup>
      <_Lines420>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.String]::Copy('').PadRight(420, 'x')), 'x', '// line;'))))</_Lines420>
    </PropertyGroup>
    <WriteLinesToFile File="$(_FixtureRoot)Core\Tracked.cs" Lines="$(_Lines420)" Overwrite="true" />
    <B44SourceSizeRatchetTask
      RepositoryRoot="$(_FixtureRoot)"
      BaselinePath="$(_FixtureRoot)ratchet-baseline.txt"
      ExcludedDirectories="@(_FixtureExclude)"
      NewFileMaxLines="500"
      TrackThresholdLines="350"
      WriteBaseline="false"
      FailOnViolation="false">
      <Output TaskParameter="ViolationCount" PropertyName="_GrowthViolations" />
    </B44SourceSizeRatchetTask>
    <Error Condition="'$(_GrowthViolations)' != '1'"
           Text="Growth past a baseline entry (400 -> 420) was not caught; got $(_GrowthViolations) violation(s)." />

    <!-- 5. Shrinking under the baseline is always allowed — that is the ratchet
            direction, and a check that punished extraction would be backwards. -->
    <PropertyGroup>
      <_Lines360>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace($([System.String]::Copy('').PadRight(360, 'x')), 'x', '// line;'))))</_Lines360>
    </PropertyGroup>
    <WriteLinesToFile File="$(_FixtureRoot)Core\Tracked.cs" Lines="$(_Lines360)" Overwrite="true" />
    <B44SourceSizeRatchetTask
      RepositoryRoot="$(_FixtureRoot)"
      BaselinePath="$(_FixtureRoot)ratchet-baseline.txt"
      ExcludedDirectories="@(_FixtureExclude)"
      NewFileMaxLines="500"
      TrackThresholdLines="350"
      WriteBaseline="false"
      FailOnViolation="false">
      <Output TaskParameter="ViolationCount" PropertyName="_ShrinkViolations" />
    </B44SourceSizeRatchetTask>
    <Error Condition="'$(_ShrinkViolations)' != '0'"
           Text="Shrinking under a baseline entry was reported as a violation; got $(_ShrinkViolations)." />

    <!-- 6. A malformed baseline must fail loudly rather than degrade into an
            empty baseline, which would silently disable the gate. -->
    <WriteLinesToFile File="$(_FixtureRoot)broken-baseline.txt" Lines="Core/Tracked.cs = not-a-number" Overwrite="true" />
    <B44SourceSizeRatchetTask
      RepositoryRoot="$(_FixtureRoot)"
      BaselinePath="$(_FixtureRoot)broken-baseline.txt"
      ExcludedDirectories="@(_FixtureExclude)"
      NewFileMaxLines="500"
      TrackThresholdLines="350"
      WriteBaseline="false"
      FailOnViolation="false"
      ContinueOnError="true" />
    <Error Condition="'$(MSBuildLastTaskResult)' == 'true'"
           Text="An unreadable baseline entry did not fail the task." />
  </Target>
</Project>
